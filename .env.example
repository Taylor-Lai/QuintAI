# 基础运行配置
APP_ENV=development
SECRET_KEY=replace-with-a-random-value-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=180
# 仅限无域名的 HTTP/IP 测试部署设为 false；正式 HTTPS 部署请留空或设为 true。
SESSION_COOKIE_SECURE=

# 可选：首次启动时创建管理员；以下三项全部留空即禁用。
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./doc_system.db

# Nginx 网关；TLS_CERT_DIR 仅在启用 HTTPS Compose 覆盖文件时填写。
HTTP_PORT=8000
NGINX_SERVER_NAME=localhost
NGINX_CLIENT_MAX_BODY_SIZE=30m
TLS_CERT_DIR=

# 模型服务（按供应商填写地址、模型和密钥）
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.8-max

# Docker 中访问外部模型需要代理时使用容器可访问的地址，例如：
# http://host.docker.internal:7897。不要填写宿主机的 127.0.0.1。
CONTAINER_HTTP_PROXY=
CONTAINER_HTTPS_PROXY=
CONTAINER_NO_PROXY=postgres,redis,app,gateway,localhost,127.0.0.1

# 可选：表格引擎性能与安全限制。
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=0
LLM_CONCURRENCY=3
LLM_CACHE_SIZE=128
LLM_MAX_CALLS_PER_RUN=40
LLM_MAX_TOTAL_TOKENS_PER_RUN=120000
TABLE_REPAIR_MAX_ATTEMPTS=1

# 上传、任务和限流
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_FILES=10
MAX_ARCHIVE_ENTRIES=2000
MAX_ARCHIVE_UNCOMPRESSED_BYTES=104857600
TASK_TIMEOUT_SECONDS=900
TASK_MAX_ATTEMPTS=2
WORKER_CONCURRENCY=2
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT=10
AI_RATE_LIMIT=6
# Docker 数据库密码（生产部署必须替换）
POSTGRES_PASSWORD=
